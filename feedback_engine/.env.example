# Environment variable template for the Feedback and Explanation Engine
# Copy this file to .env and fill in values for your local environment.
# .env is git-ignored; this file (.env.example) IS committed.

# ── Application identity ──────────────────────────────────────────────────
APP_TITLE=Feedback and Explanation Engine
APP_VERSION=1.0.0

# ── Server settings ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001

# ── Safety thresholds ─────────────────────────────────────────────────────
# Predictions below this confidence trigger cautious feedback + teacher review.
# Range: 0.0 – 1.0.  Default: 0.60
LOW_CONFIDENCE_THRESHOLD=0.60

# ── Knowledge provider ────────────────────────────────────────────────────
# "local_json"  → reads app/data/sample_geometry_rules.json (default, offline)
# "member1_api" → adapter for Member 1's knowledge base (not yet implemented)
KNOWLEDGE_PROVIDER=local_json

# ── Member 1 integration (future — not active in v1) ─────────────────────
# Set this when KNOWLEDGE_PROVIDER=member1_api
# MEMBER1_API_BASE_URL=http://localhost:8000

# ── Logging ───────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
